CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_MARS_LAYOUT_V2=y

# 动态应用的 ELF 代码段需要从 MALLOC_CAP_EXEC 内存分配。
# ESP-IDF 6.1 默认内存保护会移除此能力，因此系统应用加载器必须关闭它。
CONFIG_ESP_SYSTEM_MEMPROT=n

# V2 分区表（系统 A/B + 3 个动态应用槽 + assets + uidata）
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.v2.csv"

# 蓝牙：ESP32-S3 仅支持 BLE，使用 NimBLE 省内存；角色仅中心+观察者
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n

# PSRAM：正点原子 BOX = ESP32-S3 N16R8（Octal 8MB），字体(286KB)/显存走 PSRAM
# 内部 RAM 保留池只留 10KB 给 DMA 描述符，避免挤压 Wi-Fi/BLE（三方共存的根因）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_HW_INIT=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_PRE_CONFIGURE_MEMORY_PROTECTION=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=10240
CONFIG_GFX_EAF_JPEG_DECODE_SUPPORT=y
CONFIG_GFX_EAF_HEATSHRINK_SUPPORT=y
CONFIG_HEATSHRINK_DYNAMIC_ALLOC=y

# Verified WSS for dynamic agent apps
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# TLS buffers and contexts use the board PSRAM; retain 16 KiB RX records.
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Leave executable IRAM headroom for dynamic apps after Wi-Fi is connected.
# Keep RX IRAM optimization enabled; move general Wi-Fi hot code to cached flash.
CONFIG_ESP_WIFI_IRAM_OPT=n

CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_BUILD_EXAMPLES=n
